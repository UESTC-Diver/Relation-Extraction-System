# 本文件只是配置项清单，代码不自动加载 .env。
# 用系统环境变量、systemd EnvironmentFile 或容器 env 注入；不配置时保持本机开箱即用。
#
# 生产最小 checklist：
#   1) 设置 APP_ALLOWED_ORIGINS 为自己的域名（逗号分隔多个）
#   2) 设置 APP_API_TOKEN，并把 APP_REPORT_SECRET 设成独立长随机串
#   3) 确认前端 dist 已构建、服务只监听反代后的本机端口、HTTPS 由反代终止
#   4) 定期备份 data/app.db（含 WAL）；data/.report-secret 也要一起备份
#   生成随机串：python -c "import secrets; print(secrets.token_hex(32))"

# 跨域白名单。默认只允许本机 8000 / Vite 5173，生产改成你的域名。
APP_ALLOWED_ORIGINS=https://your-domain.example

# 写保护：设置后所有非只读 /api 请求须带 X-API-Token。
APP_API_TOKEN=

# 报告分享签名：设置后 /report/{id} 必须带有效签名与过期时间。
# 未设置时本机仍可裸链访问，且自动用 data/.report-secret 生成签名链接。
APP_REPORT_SECRET=

# 每个 IP 每分钟的 /api 与 /report 请求上限（单进程计数）。
APP_RATE_LIMIT_PER_MIN=120

# 全局请求体上限（字节），默认 4 MB；单文件上传另受 2 MB 限制。
APP_MAX_BODY_BYTES=4194304

# PDF / DOCX 本地解析超时（秒）。
APP_PARSE_TIMEOUT=10

# 抽取并发额度。
APP_MAX_CONCURRENT_EXTRACT=4

# SQLite 路径；测试由 APP_DB_PATH 指向 tmp_path 覆盖。
# APP_DB_PATH=data/app.db
